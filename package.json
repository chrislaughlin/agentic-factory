{
  "name": "agentic-factory",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "type": "module",
  "bin": {
    "agent-factory": "dist/cli.js"
  },
  "scripts": {
    "agent-factory": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "security": "pnpm audit --prod --audit-level high",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm format:check && pnpm security"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.17.0",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
