{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-factory/technical-blueprint/v1",
  "title": "Agent Factory technical blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "role",
    "artifact_id",
    "baseline_sha",
    "content_hash",
    "status",
    "change_classification",
    "scope",
    "implementation",
    "risk_controls",
    "unresolved_decisions",
    "acceptance_mapping",
    "verification_mapping"
  ],
  "properties": {
    "schema_version": { "const": "technical-blueprint.v1" },
    "kind": { "const": "technical-blueprint" },
    "role": { "const": "design-solution" },
    "artifact_id": { "$ref": "#/$defs/artifact_id" },
    "baseline_sha": { "$ref": "#/$defs/sha" },
    "content_hash": { "$ref": "#/$defs/hash" },
    "status": { "enum": ["draft", "decision-needed", "complete"] },
    "change_classification": { "enum": ["local", "multi-layer", "api", "shared-type", "schema", "migration", "auth", "rollout", "security", "concurrency", "performance", "operability", "broad-impact-bug", "unknown"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in_scope", "out_of_scope"],
      "properties": {
        "in_scope": { "$ref": "#/$defs/string_list" },
        "out_of_scope": { "$ref": "#/$defs/string_list" }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components", "interfaces", "data_and_state", "failure_handling"],
      "properties": {
        "components": { "$ref": "#/$defs/string_list" },
        "interfaces": { "$ref": "#/$defs/string_list" },
        "data_and_state": { "$ref": "#/$defs/string_list" },
        "failure_handling": { "$ref": "#/$defs/string_list" },
        "compatibility": { "$ref": "#/$defs/string_list" },
        "sequencing": { "$ref": "#/$defs/string_list" }
      }
    },
    "risk_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["security", "concurrency", "performance", "operability"],
      "properties": {
        "security": { "$ref": "#/$defs/string_list" },
        "concurrency": { "$ref": "#/$defs/string_list" },
        "performance": { "$ref": "#/$defs/string_list" },
        "operability": { "$ref": "#/$defs/string_list" },
        "rollout": { "$ref": "#/$defs/string_list" },
        "rollback": { "$ref": "#/$defs/string_list" }
      }
    },
    "unresolved_decisions": { "$ref": "#/$defs/decision_list" },
    "acceptance_mapping": { "$ref": "#/$defs/mapping_list" },
    "verification_mapping": { "$ref": "#/$defs/mapping_list" }
  },
  "$defs": {
    "artifact_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "string_list": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "status": { "enum": ["unresolved", "resolved"] },
        "answer": { "type": "string" }
      }
    },
    "decision_list": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "mapping": {
      "description": "id is unique within the artifact; acceptance mappings define requirement IDs and implementation/change targets, while verification mappings reference those acceptance IDs and declare verification evidence targets.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "targets"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "targets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "mapping_list": { "type": "array", "items": { "$ref": "#/$defs/mapping" } }
  }
}
