{
  "happy_path": {
    "stages": ["planning", "construction", "parallel-verification", "qa", "code-quality", "publication", "monitoring", "human-handoff"],
    "terminal_owner": "human"
  },
  "ci_failure": { "monitor_status": "fail", "next_stage": "construction", "fresh_attempt_budget": 3 },
  "requested_changes": { "monitor_status": "fail", "next_stage": "construction", "fresh_attempt_budget": 3 },
  "contradictory_feedback": { "monitor_status": "blocked", "next_stage": "human-decision" },
  "poll_timeout": { "monitor_status": "blocked", "next_stage": "resume-monitoring" },
  "qa_runtime_unavailable": { "qa_status": "blocked", "publish": false },
  "validated_quality_finding": { "review_status": "fail", "next_stage": "construction", "publish": false },
  "third_failed_cycle": { "attempt": 3, "next_stage": "human-decision", "publish": false },
  "resume": { "validate": ["repository", "worktree", "branch", "head", "recorded revisions"] },
  "worktree_isolation": {
    "required": true,
    "writable_stages": ["construction", "author-tests", "remediation"],
    "primary_checkout_writes": false
  },
  "human_boundary": { "agent_may": ["create ready PR/MR", "monitor CI and reviews"], "agent_must_not": ["merge", "deploy"] }
}
